<?xml version="1.0" encoding="UTF-8" ?>
<config>
    <luceneMatchVersion>9.10.0</luceneMatchVersion>
    <schemaFactory class="ManagedIndexSchemaFactory">
        <bool name="mutable">true</bool>
        <str name="managedSchemaResourceName">managed-schema.xml</str>
    </schemaFactory>


    <dataDir>${solr.data.dir:}</dataDir>

    <directoryFactory name="DirectoryFactory"
                      class="${solr.directoryFactory:solr.NRTCachingDirectoryFactory}"/>

    <codecFactory class="solr.SchemaCodecFactory"/>

    <indexConfig>
        <lockType>${solr.lock.type:native}</lockType>
    </indexConfig>

    <updateHandler class="solr.DirectUpdateHandler2">
        <updateLog>
            <str name="dir">${solr.ulog.dir:}</str>
        </updateLog>
        <autoCommit>
            <maxTime>15000</maxTime>
            <openSearcher>false</openSearcher>
        </autoCommit>
    </updateHandler>

    <!-- Leader-follower index replication. Off by default; role is set in solr.in.sh:
           leader:   -Dvlo.replication.leader=true
           follower: -Dvlo.replication.follower=true -Dvlo.replication.leaderUrl=http://<leader>:8983/solr
         Followers do not poll; the importer does a command=fetchindex after an import. -->
    <requestHandler name="/replication" class="solr.ReplicationHandler">
        <lst name="leader">
            <str name="enable">${vlo.replication.leader:false}</str>
            <str name="replicateAfter">commit</str>
            <str name="replicateAfter">startup</str>
            <str name="confFiles">managed-schema.xml</str>
        </lst>
        <lst name="follower">
            <str name="enable">${vlo.replication.follower:false}</str>
            <str name="leaderUrl">${vlo.replication.leaderUrl:http://localhost:8983/solr}/vlo-morgue/replication</str>
        </lst>
    </requestHandler>

    <requestHandler name="/select" class="solr.SearchHandler">
        <lst name="defaults">
            <str name="echoParams">explicit</str>
            <int name="rows">10</int>
        </lst>
    </requestHandler>

    <requestHandler name="/update" class="solr.UpdateRequestHandler"/>

    <requestHandler name="/admin/ping" class="solr.PingRequestHandler">
        <lst name="invariants">
            <str name="q">*:*</str>
        </lst>
        <lst name="defaults">
            <str name="echoParams">all</str>
        </lst>
    </requestHandler>

</config>
